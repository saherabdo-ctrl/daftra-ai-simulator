# ============================================================
# DaftraAI-Simulator — Environment Configuration
# ============================================================
# Copy this file to .env (local dev) or set via cloud provider secrets.
# NEVER commit real secrets to Git.
# ============================================================

# ---- LiveKit (REQUIRED) ----
# Create a free project at https://cloud.livekit.io and copy your credentials here.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ---- Groq (REQUIRED) ----
# Free: https://console.groq.com/keys (no credit card needed)
GROQ_API_KEY=gsk-your-groq-key

# ---- Deepgram (REQUIRED) ----
# Get from https://console.deepgram.com (free $200 credit)
DEEPGRAM_API_KEY=your_deepgram_key

# ---- Gemini (recommended: free tier, generous daily quota) ----
# Get a free key at https://aistudio.google.com/apikey
# When set, Gemini powers customer replies + evaluation instead of Groq.
# GEMINI_API_KEY=
# GEMINI_LLM_MODEL=gemini-flash-lite-latest
# GEMINI_EVAL_MODEL=gemini-flash-lite-latest

# ---- Server ----
PORT=8000
AGENT_NAME=daftra-ai-simulator

# ---- Internal URLs (auto-detected in single-process mode) ----
# In production (single container), both server and agent run in one process.
# These default to http://localhost:8000 which works within the container.
# EVALUATION_WEBHOOK_URL=http://localhost:8000/api/results
# SCENARIOS_BASE_URL=http://localhost:8000

# ---- Security ----
# JWT signing secret — set a strong random value in production
JWT_SECRET=your-secret-key-here
# Admin login password (used only when data/users.json is first created)
# ADMIN_PASSWORD=

# ---- Webhook secret (optional) ----
# AGENT_WEBHOOK_SECRET=

# ---- Speech Recognition ----
STT_LANGUAGE=ar
# STT_PROVIDER: "deepgram" (default, fast) or "groq" (Whisper, more accurate)
STT_PROVIDER=deepgram

# ---- Text-to-Speech ----
# Options: edge (free, default) | elevenlabs (paid, premium) | gemini (needs Pro key)
TTS_PROVIDER=edge
# EDGE_TTS_VOICE=ar-SA-HamedNeural
# ELEVEN_API_KEY=your_elevenlabs_key
# ELEVEN_VOICE_SAUDI=your_voice_id

# ---- Recordings ----
# Where to store call recordings, transcripts, and evaluations.
# In Docker/Fly.io, use the mounted volume path.
# RECORDINGS_PATH=/recordings

# ---- Google Sheets (REQUIRED for HiringFlow integration) ----
# Google Sheet ID from: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
GOOGLE_SHEET_ID=your_google_sheet_id

# Path to Google Service Account JSON credentials file (local dev)
# Create at: https://console.cloud.google.com → IAM → Service Accounts → Create
GOOGLE_CREDENTIALS=path/to/service_account.json

# On hosts where you can't drop a credentials file next to the code (e.g. SnapDeploy,
# Render), paste the full contents of the service account JSON file here instead.
# When set, this takes priority over GOOGLE_CREDENTIALS.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Shared Drive ID (optional — for uploading to Shared Drive instead of personal Drive)
# Find it in the Shared Drive URL: https://drive.google.com/drive/folders/{SHARED_DRIVE_ID}
# SHARED_DRIVE_ID=your_shared_drive_id

# ---- HiringFlow Callback (Optional) ----
# URL where AI Simulator sends completed evaluation results
# HIRINGFLOW_WEBHOOK_URL=https://script.google.com/macros/s/xxx/exec
# HIRINGFLOW_WEBHOOK_SECRET=your_webhook_secret
