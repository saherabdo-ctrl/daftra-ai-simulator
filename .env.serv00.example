# ============================================================
#  نسخة من هذا الملف تسمى .env وتوضع في مجلد المشروع على Serv00.
#  عدّل القيم بمفاتيحك الحقيقية قبل التشغيل.
# ============================================================

# ---- LiveKit Cloud (المفيد للمكالمات الصوتية) ----
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET

# ---- الذكاء الاصطناعي ----
GEMINI_API_KEY=YOUR_GEMINI_KEY
# GROQ_API_KEY=

# ---- التعرف على الكلام ----
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_KEY

# ---- الصوت (TTS) ----
# الافتراضي: Microsoft Edge مجاني بلا مفتاح (صوت سعودي أصيل). اختياري:
# ElevenLabs بأصوات سعودية طبيعية جدًا — من https://elevenlabs.io
# ELEVEN_API_KEY=YOUR_ELEVENLABS_KEY
# TTS_PROVIDER=elevenlabs
# ELEVEN_VOICE_SAUDI=8KMBeKnOSHXjLqGuWsAE
# ELEVEN_VOICE_SAUDI_MALE=8KMBeKnOSHXjLqGuWsAE
# ELEVEN_VOICE_SAUDI_FEMALE=E4GutuQ39akNBbiYuhh2

# ---- العميل الآلي ----
# اسم مميز للوضع المستضاف حتى لا يتعارض مع وضع اللابتوب المحلي.
AGENT_NAME=sdr-training-agent-hosted
# نطاقك المجاني على Serv00 (بعد إعداد الموقع في اللوحة)
EVALUATION_WEBHOOK_URL=https://SUBDOMAIN.serv00.net/api/results
SCENARIOS_BASE_URL=https://SUBDOMAIN.serv00.net
AGENT_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---- الحساب الأول ----
ADMIN_PASSWORD=change-me-admin-password