# ============================================================
#  نسخة من هذا الملف تسمى .env.production وتُملأ بمفاتيحك ثم تُرفع للخادم.
#  لا ترفع هذا المثال نفسه، ولا ترفع ملف .env الحالي (فيه مفاتيحك الشخصية).
# ============================================================

# ---- LiveKit Cloud (المفيد للمكالمات الصوتية) ----
# من https://cloud.livekit.io → Project Settings → Keys
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET

# ---- الذكاء الاصطناعي (اختياري لكنه أفضل: رصيد مجاني كبير) ----
# من https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_KEY
# احتياطي إن لم يتوفر Gemini — من https://console.groq.com
# GROQ_API_KEY=

# ---- التعرف على الكلام ----
# من https://deepgram.com → Console → API Keys
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_KEY

# ---- الصوت (TTS) ----
# الافتراضي: Microsoft Edge مجاني بلا مفتاح (صوت سعودي أصيل). اختياري:
# ElevenLabs بأصوات سعودية طبيعية جدًا (معيار تجاري) — من https://elevenlabs.io
# ELEVEN_API_KEY=YOUR_ELEVENLABS_KEY
# TTS_PROVIDER=elevenlabs
# ELEVEN_VOICE_SAUDI=8KMBeKnOSHXjLqGuWsAE
# ELEVEN_VOICE_SAUDI_MALE=8KMBeKnOSHXjLqGuWsAE
# ELEVEN_VOICE_SAUDI_FEMALE=E4GutuQ39akNBbiYuhh2

# ---- العميل الآلي ----
# اسم مميز للوضع المستضاف حتى لا يتعارض مع وضع اللابتوب المحلي.
AGENT_NAME=sdr-training-agent-hosted
# داخل docker compose يصل العميل الآلي لخادم الويب عبر اسم الخدمة "web"
EVALUATION_WEBHOOK_URL=http://web:8000/api/results
SCENARIOS_BASE_URL=http://web:8000
# سر مشترك بين العميل الآلي والخادم — غيّره لقيمة عشوائية طويلة
AGENT_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---- الحساب الأول (يُستخدم فقط عند إنشاء المستخدمين لأول مرة) ----
ADMIN_PASSWORD=change-me-admin-password